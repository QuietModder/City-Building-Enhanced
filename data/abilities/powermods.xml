  <!-- Challenge strikes a targeted enemy, then temporarily grants armor and -->
  <!-- damage that scales with nearby enemies. -->
  <power name="CBEChallenge" type="UnitAction">
    <displaynameid>9914054</displaynameid>
    <rolloverid>9914055</rolloverid>
    <icon>resources\images\icons\Abilites\cbe_challenge.png</icon>
    <minimapeventtime sendalertto="none">1</minimapeventtime>
    <activetime>10</activetime>
    <radius>18.0</radius>
    <placement forceonmap="1" enemy="" allowgaia="">unit</placement>
    <abstractattacktargettype>Unit</abstractattacktargettype>
    <unitaction>ChallengeAttack</unitaction>
    <auxiliarypower>CBEChallengeArmor</auxiliarypower>
    <auxiliarypowertargettype>self</auxiliarypowertargettype>
    <forceattacktarget>1</forceattacktarget>
    <allowduringnorush>1</allowduringnorush>
    <startsoundset>BattlecryMedium</startsoundset>
  </power>
  <power name="CBEChallengeArmor" type="GeneralEffect">
    <timerrolloverid>9914056</timerrolloverid>
    <minimapeventtime sendalertto="none">1</minimapeventtime>
    <activetime>10</activetime>
    <effect type="ActionEnable" action="CBEChallengeDefense">
      <target type="ProtoUnit">CBELeagueShieldBearer</target>
    </effect>
    <effect type="ActionEnable" action="CBEChallengeEnemyStrength">
      <target type="ProtoUnit">CBELeagueShieldBearer</target>
    </effect>
    <messagealertplayerrelation>none</messagealertplayerrelation>
    <placement forceonmap="1">LOSDontCare</placement>
    <allowduringnorush>1</allowduringnorush>
    <isauxiliarypower>1</isauxiliarypower>
  </power>

  <!-- Brace for Impact extends both Challenge effects to 20 seconds. -->
  <power name="CBEChallengeBraceForImpact" type="UnitAction">
    <displaynameid>9914054</displaynameid>
    <rolloverid>9914076</rolloverid>
    <icon>resources\images\icons\Abilites\cbe_challenge.png</icon>
    <minimapeventtime sendalertto="none">1</minimapeventtime>
    <activetime>20</activetime>
    <radius>18.0</radius>
    <placement forceonmap="1" enemy="" allowgaia="">unit</placement>
    <abstractattacktargettype>Unit</abstractattacktargettype>
    <unitaction>ChallengeAttack</unitaction>
    <auxiliarypower>CBEChallengeArmorBraceForImpact</auxiliarypower>
    <auxiliarypowertargettype>self</auxiliarypowertargettype>
    <forceattacktarget>1</forceattacktarget>
    <allowduringnorush>1</allowduringnorush>
    <startsoundset>BattlecryMedium</startsoundset>
  </power>
  <power name="CBEChallengeArmorBraceForImpact" type="GeneralEffect">
    <timerrolloverid>9914056</timerrolloverid>
    <minimapeventtime sendalertto="none">1</minimapeventtime>
    <activetime>20</activetime>
    <effect type="ActionEnable" action="CBEChallengeDefense">
      <target type="ProtoUnit">CBELeagueShieldBearer</target>
    </effect>
    <effect type="ActionEnable" action="CBEChallengeEnemyStrength">
      <target type="ProtoUnit">CBELeagueShieldBearer</target>
    </effect>
    <messagealertplayerrelation>none</messagealertplayerrelation>
    <placement forceonmap="1">LOSDontCare</placement>
    <allowduringnorush>1</allowduringnorush>
    <isauxiliarypower>1</isauxiliarypower>
  </power>

  <!-- Last Bastion: direct invulnerability mirrors the proven vanilla Divine Right -->
  <!-- pattern. Regeneration carries its independent duration in the tactics action. -->
  <power name="CBELastBastion" type="GeneralEffect">
    <displaynameid>9914097</displaynameid>
    <rolloverid>9914098</rolloverid>
    <timerrolloverid>9914099</timerrolloverid>
    <icon>resources\images\icons\Abilites\cbe_last_bastion.png</icon>
    <minimapeventtime sendalertto="none">1</minimapeventtime>
    <activetime>5</activetime>
    <effect type="CanTargetButTakesNoDamage">
      <target type="ProtoUnit">CBELeagueShieldBearer</target>
    </effect>
    <effect type="ActionEnable" action="CBELastBastionRegeneration">
      <target type="ProtoUnit">CBELeagueShieldBearer</target>
    </effect>
    <messagealertplayerrelation>none</messagealertplayerrelation>
    <placement forceonmap="1" ally="">full</placement>
    <allowduringnorush>1</allowduringnorush>
    <startsoundset>PowerInvulnerability</startsoundset>
    <alwaysaddtoplayer>1</alwaysaddtoplayer>
  </power>

  <!-- Into the Breach: Shielder's primary and auxiliary charged attacks. -->
