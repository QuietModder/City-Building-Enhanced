<tactics>
  <action>
    <name stringid="43019">AutoGather</name>
    <type>AutoGather</type>
    <persistent>1</persistent>
  </action>

  <!-- Citadel resource auras.  Each branch enables one of these actions. -->
  <action>
    <name stringid="68961">BunkerMillNaturalFoodAura</name>
    <type>AutoRangedModify</type>
    <active>1</active>
    <maxrange>30</maxrange>
    <modifyabstracttype>AbstractVillager</modifyabstracttype>
    <persistent>1</persistent>
    <nostack>1</nostack>
    <nostackignorepuid>1</nostackignorepuid>
    <modifytype>NaturalFoodGatherRate</modifytype>
    <modifymultiplier>1.10</modifymultiplier>
    <modelattachment>effects\ypack_auras\econpower.xml</modelattachment>
    <modelattachmentbone>bonethatdoesntexist</modelattachmentbone>
  </action>
  <action>
    <name stringid="68961">BunkerMillTreeAura</name>
    <type>AutoRangedModify</type>
    <active>1</active>
    <maxrange>30</maxrange>
    <modifyabstracttype>AbstractVillager</modifyabstracttype>
    <persistent>1</persistent>
    <nostack>1</nostack>
    <nostackignorepuid>1</nostackignorepuid>
    <modifytype>TreeGatherRate</modifytype>
    <modifymultiplier>1.10</modifymultiplier>
    <modelattachment>effects\ypack_auras\econpower.xml</modelattachment>
    <modelattachmentbone>bonethatdoesntexist</modelattachmentbone>
  </action>
  <action>
    <name stringid="68961">BunkerMillMineAura</name>
    <type>AutoRangedModify</type>
    <active>1</active>
    <maxrange>30</maxrange>
    <modifyabstracttype>AbstractVillager</modifyabstracttype>
    <persistent>1</persistent>
    <nostack>1</nostack>
    <nostackignorepuid>1</nostackignorepuid>
    <modifytype>MineGatherRate</modifytype>
    <modifymultiplier>1.10</modifymultiplier>
    <modelattachment>effects\ypack_auras\econpower.xml</modelattachment>
    <modelattachmentbone>bonethatdoesntexist</modelattachmentbone>
  </action>
  <action>
    <name stringid="68961">BunkerMillFarmWorkRateAura</name>
    <type>AutoRangedModify</type>
    <active>1</active>
    <maxrange>30</maxrange>
    <modifyabstracttype>AbstractFarmBuilding</modifyabstracttype>
    <persistent>1</persistent>
    <nostack>1</nostack>
    <nostackignorepuid>1</nostackignorepuid>
    <modifytype>BuildingWorkRate</modifytype>
    <modifymultiplier>1.15</modifymultiplier>
    <modelattachment>effects\ypack_auras\econpower.xml</modelattachment>
    <modelattachmentbone>bonethatdoesntexist</modelattachmentbone>
  </action>

  <tactic>Normal<action>AutoGather</action><action>BunkerMillNaturalFoodAura</action><action>BunkerMillTreeAura</action><action>BunkerMillMineAura</action><action>BunkerMillFarmWorkRateAura</action></tactic>
</tactics>
