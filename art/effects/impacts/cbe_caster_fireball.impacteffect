<impacteffect metercount="4" meterlength="1.0">
  <!-- Caster fireballs use the compact grenade burst and collision-timed audio. -->
  <wood>
    <particleset>grenade_impact_generic</particleset>
    <soundset>CannonImpactWood</soundset>
    <soundset>Grenade</soundset>
  </wood>
  <stone>
    <particleset>grenade_impact_generic</particleset>
    <soundset>CannonImpactStone</soundset>
    <soundset>Grenade</soundset>
  </stone>
  <flesh>
    <particleset>dynamite_impact_flesh</particleset>
    <soundset>Grenade</soundset>
  </flesh>
  <dirt>
    <particleset>mortar_impact_dirt</particleset>
    <soundset>Grenade</soundset>
  </dirt>
  <snow>
    <particleset>mortar_impact_snow</particleset>
    <soundset>Grenade</soundset>
  </snow>
  <animal>
    <particleset>dynamite_impact_flesh</particleset>
    <soundset>CannonImpactFlesh</soundset>
    <soundset>Grenade</soundset>
  </animal>
  <terraingrass>
    <particleset>mortar_impact_grass</particleset>
    <soundset>Grenade</soundset>
  </terraingrass>
  <terrainwater>
    <particleset>mortar_impact_water</particleset>
    <soundset>Grenade</soundset>
  </terrainwater>
  <terraindirt>
    <particleset>mortar_impact_dirt</particleset>
    <soundset>Grenade</soundset>
  </terraindirt>
  <terrainstone>
    <particleset>grenade_impact_generic</particleset>
    <soundset>CannonImpactStone</soundset>
    <soundset>Grenade</soundset>
  </terrainstone>
  <terrainsnow>
    <particleset>mortar_impact_snow</particleset>
    <soundset>Grenade</soundset>
  </terrainsnow>
  <terrainsand>
    <particleset>mortar_impact_sand</particleset>
    <soundset>Grenade</soundset>
  </terrainsand>
</impacteffect>
